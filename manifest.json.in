{
  "manifest_version": 1,
  "id": "mouse-jiggler",
  "i18n": {
    "default": {"name": "Mouse Jiggler", "description": "Moves the mouse slightly on a timer so the controlled computer stays awake."},
    "zh": {"name": "鼠标抖动", "description": "定时轻微移动鼠标，避免被控电脑休眠。"},
    "zh-TW": {"name": "滑鼠抖動", "description": "定時輕微移動滑鼠，避免被控電腦休眠。"}
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-mouse-jiggler",
  "entrypoint": "bin/onekvm-mouse-jiggler",
  "permissions": [],
  "capabilities": ["hid"],
  "services": [{
    "id": "jiggler",
    "i18n": {
      "default": {"name": "Mouse jiggler", "description": "Keeps the controlled computer awake."},
      "zh": {"name": "鼠标抖动", "description": "避免被控电脑休眠。"},
      "zh-TW": {"name": "滑鼠抖動", "description": "避免被控電腦休眠。"}
    }
  }],
  "icon": {"source": "lucide", "name": "mouse-pointer-2"},
  "page": {"title": "Mouse Jiggler", "renderer": "layout", "entrypoint": "web/page.json", "icon": {"source": "lucide", "name": "mouse-pointer-2"}},
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["interval_seconds"],
    "properties": {
      "interval_seconds": {
        "type": "integer", "title": "Jiggle interval (seconds)", "default": 60, "minimum": 5, "maximum": 86400,
        "i18n": {"default": "Jiggle interval (seconds)", "zh": "抖动间隔（秒）", "zh-TW": "抖動間隔（秒）"}
      }
    }
  },
  "secret_fields": [],
  "memory_budget": "1M",
  "resource_limits": {"memory_max": "8M", "cpu_quota": "5%", "tasks_max": 4, "limit_nofile": 16},
  "healthcheck": {"type": "exec", "command": ["bin/onekvm-mouse-jiggler", "--health"], "timeout_seconds": 5}
}
